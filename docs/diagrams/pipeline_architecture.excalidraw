    {
      "type": "text",
      "id": "t_id_514493",
      "x": 540,
      "y": 207.75,
      "width": 350,
      "height": 84.50000000000001,
      "text": "Siamese Dual-Branch Encoders\n\u2022 Front Branch: ResNet-18 / ConViT (GPSA)\n\u2022 Side Branch: ResNet-18 / ConViT (GPSA)\n\u2022 Learns cross-view 3D shape priors\n\u2022 Output features: h_f, h_s in R^512",
      "originalText": "Siamese Dual-Branch Encoders\n\u2022 Front Branch: ResNet-18 / ConViT (GPSA)\n\u2022 Side Branch: ResNet-18 / ConViT (GPSA)\n\u2022 Learns cross-view 3D shape priors\n\u2022 Output features: h_f, h_s in R^512",
