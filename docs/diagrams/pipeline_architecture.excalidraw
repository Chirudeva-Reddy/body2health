    {
      "type": "text",
      "id": "id_580706",
      "x": 1444,
      "y": 456,
      "width": 342,
      "height": 111,
      "text": "# Dual geometric verification\niou = compute_iou(S_render, S_observed)\nchamfer = compute_chamfer(c_render, c_obs)\n\nmismatch_penalty = (\n    0.70 * (1.0 - iou) +\n    0.30 * chamfer\n)\ngate_pass = (iou >= 0.55 and chamfer <= 0.05)",
      "originalText": "# Dual geometric verification\niou = compute_iou(S_render, S_observed)\nchamfer = compute_chamfer(c_render, c_obs)\n\nmismatch_penalty = (\n    0.70 * (1.0 - iou) +\n    0.30 * chamfer\n)\ngate_pass = (iou >= 0.55 and chamfer <= 0.05)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#38bdf8",
