    {
      "type": "text",
      "id": "id_970157",
      "x": 544,
      "y": 536,
      "width": 342,
      "height": 121,
      "text": "# NT-Xent contrastive loss (tau=0.07)\nsim = (z_front @ z_side.T) / tau\nL_contrastive = 0.5 * (\n    cross_entropy(sim, labels) +\n    cross_entropy(sim.T, labels)\n)\n# Multi-task joint optimization\nL_total = L_contrastive + 2.0 * L_reg_L1",
      "originalText": "# NT-Xent contrastive loss (tau=0.07)\nsim = (z_front @ z_side.T) / tau\nL_contrastive = 0.5 * (\n    cross_entropy(sim, labels) +\n    cross_entropy(sim.T, labels)\n)\n# Multi-task joint optimization\nL_total = L_contrastive + 2.0 * L_reg_L1",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#38bdf8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
